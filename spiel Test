import pgzrun
import random

#fenster
WIDTH     = 740
HEIGHT    = 740
TITLE     = "Pastel Farm Tycoon"

# UI-Leiste am unteren Rand
UI_HOEHE  = 90
FARMHOEHE = HEIGHT - UI_HOEHE    # 650 px Spielfeld

#layout
SPALTEN       = 3
ZEILEN        = 3
BEETGROESSE   = 48     # Breite und Hoehe eines Beet-Bildes
BEETABSTAND   = 130    # Abstand von Mitte zu Mitte (Beet + Luft)

# Startposition oben links des gesamten Gitters (zentriert)
GITTER_X = (WIDTH    - (SPALTEN - 1) * BEETABSTAND - BEETGROESSE) // 2   # 223
GITTER_Y = (FARMHOEHE - (ZEILEN  - 1) * BEETABSTAND - BEETGROESSE) // 2  # 173

def beet_x(spalte):
    return GITTER_X + spalte * BEETABSTAND

def beet_y(zeile):
    return GITTER_Y + zeile  * BEETABSTAND

#farben
TEXTFARBE   = ( 90,  60,  80)
GOLDFARBE   = (255, 200,  80)
GRUENFARBE  = (100, 200, 120)
ROTFARBE    = (240, 100, 100)
WASSERFARBE = (100, 180, 255)
UIFARBE     = (255, 235, 245)
GITTERFARBE = (220, 200, 210)

PFLANZEN = {
    "Salat": {
        "kosten":    3,
        "gewinn":    8,
        "wachszeit": 5,
        "farbe":    (120, 200,  80),
        "keim":     "salat_keim",
        "reif":     "salat_reif",
    },
    "Sonnenblume": {
        "kosten":    6,
        "gewinn":   18,
        "wachszeit":10,
        "farbe":    (255, 220,  60),
        "keim":     "sonnenblume_keim",
        "reif":     "sonnenblume_reif",
    },
    "Radieschen": {
        "kosten":    4,
        "gewinn":   10,
        "wachszeit": 6,
        "farbe":    (230,  80, 120),
        "keim":     "radieschen_keim",
        "reif":     "radieschen_reif",
    },
    "Kuerbis": {
        "kosten":    8,
        "gewinn":   22,
        "wachszeit":14,
        "farbe":    (240, 140,  40),
        "keim":     "kuerbis_keim",
        "reif":     "kuerbis_reif",
    },
}
PFLANZENLISTE = list(PFLANZEN.keys())

#spielzustand
geld              = 50
level             = 1
levelziel         = 150
restzeit          = 90.0
verloren          = False
gewonnen          = False
wetter            = "Sonne"
wettertimer       = 0.0
WETTERINTERVALL   = 20.0
gewaehltepflanze  = "Salat"
endesoundgespielt = False


partikel = []

beetbilder = []
beetdaten  = []

for zeile in range(ZEILEN):
    bildreihe  = []
    datenreihe = []
    for spalte in range(SPALTEN):
        beet         = Actor("beet_leer")
        beet.topleft = (beet_x(spalte), beet_y(zeile))
        bildreihe.append(beet)
        datenreihe.append(["leer", 0.0, None, False])
    beetbilder.append(bildreihe)
    beetdaten.append(datenreihe)

baum_links        = Actor("baum1")
baum_links.center = (GITTER_X // 2, FARMHOEHE - 80)

baum_rechts        = Actor("baum2")
baum_rechts.center = (WIDTH - GITTER_X // 2, FARMHOEHE - 80)

HASE_BEREICH_OBEN  = FARMHOEHE - 120
HASE_BEREICH_UNTEN = FARMHOEHE - 20

hase           = Actor("hase_stehend")
hase.center    = (WIDTH // 2, HASE_BEREICH_UNTEN - 7)
hase_richtung  = "stehend"
hase_schritt   = 0
hase_bewtimer  = 0.0
hase_animtimer = 0.0
hase_dx        = 0
hase_dy        = 0

HASE_BILDER = {
    "links":   ["hase_links_1",  "hase_links_2"],
    "rechts":  ["hase_rechts_1", "hase_rechts_2"],
    "stehend": ["hase_stehend"],
}

def sound(name):
    try:
        getattr(sounds, name).play()
    except Exception:
        pass

def musik_an():
    try:
        music.play("hintergrundmusik")
        music.set_volume(0.4)
    except Exception:
        pass

def beetbild_setzen(spalte, zeile):
    status = beetdaten[zeile][spalte][0]
    if status == "leer":
        beetbilder[zeile][spalte].image = "beet_leer"
    elif status == "wachsend":
        beetbilder[zeile][spalte].image = "beet_wachsend"
    elif status == "bereit":
        beetbilder[zeile][spalte].image = "beet_bereit"

def fortschritt(spalte, zeile):
    daten = beetdaten[zeile][spalte]
    if daten[2] is None:
        return 0.0
    return min(daten[1] / PFLANZEN[daten[2]]["wachszeit"], 1.0)

def kasten(farbe, x, y, breite, hoehe, radius=8):
    screen.draw.filled_rect(Rect(x + radius, y,          breite - 2*radius, hoehe),           farbe)
    screen.draw.filled_rect(Rect(x,          y + radius, breite,            hoehe - 2*radius), farbe)
    for ex, ey in [(x+radius, y+radius), (x+breite-radius, y+radius),
                   (x+radius, y+hoehe-radius), (x+breite-radius, y+hoehe-radius)]:
        screen.draw.filled_circle((ex, ey), radius, farbe)

def einpflanzen(spalte, zeile):
    global geld
    kosten = PFLANZEN[gewaehltepflanze]["kosten"]
    if geld >= kosten:
        beetdaten[zeile][spalte] = ["wachsend", 0.0, gewaehltepflanze, False]
        geld -= kosten
        beetbild_setzen(spalte, zeile)
        sound("pflanzen")

def giessen(spalte, zeile):
    daten = beetdaten[zeile][spalte]
    if daten[0] == "wachsend":
        daten[1] += 2.0
        daten[3]  = True
        sound("giessen")
        # Partikel um die Beetmitte
        mx = beet_x(spalte) + BEETGROESSE // 2
        my = beet_y(zeile)  + BEETGROESSE // 2
        for _ in range(8):
            partikel.append([
                mx + random.randint(-10, 10),
                my + random.randint(-10, 10),
                random.uniform(-1.0, 1.0),
                random.uniform(-2.0, -0.3),
                1.0,
            ])

def ernten(spalte, zeile):
    global geld
    daten = beetdaten[zeile][spalte]
    if daten[0] == "bereit":
        geld += PFLANZEN[daten[2]]["gewinn"]
        beetdaten[zeile][spalte] = ["leer", 0.0, None, False]
        beetbild_setzen(spalte, zeile)
        sound("ernten")

def naechstes_level():
    global level, levelziel, restzeit, gewonnen
    if level >= 3:
        gewonnen = True
        return
    level    += 1
    levelziel = int(levelziel * 2.2)
    restzeit  = max(restzeit, 60.0) + 30.0
    sound("level_up")

def on_mouse_down(pos):
    global gewaehltepflanze

    if verloren or gewonnen:
        return

    # Shop-Buttons
    shopx = 10
    for name in PFLANZENLISTE:
        if shopx <= pos[0] <= shopx + 160 and FARMHOEHE + 38 <= pos[1] <= FARMHOEHE + 80:
            gewaehltepflanze = name
            return
        shopx += 183

    # Beete – Klick per collidepoint auf den 48x48 Actor
    for zeile in range(ZEILEN):
        for spalte in range(SPALTEN):
            if beetbilder[zeile][spalte].collidepoint(pos):
                status = beetdaten[zeile][spalte][0]
                if status == "leer":
                    einpflanzen(spalte, zeile)
                elif status == "wachsend":
                    giessen(spalte, zeile)
                elif status == "bereit":
                    ernten(spalte, zeile)
                return
#update-funktion
def update(dt):
    global restzeit, verloren, gewonnen
    global wetter, wettertimer
    global hase_richtung, hase_schritt, hase_bewtimer, hase_animtimer
    global hase_dx, hase_dy
    global endesoundgespielt

    if verloren or gewonnen:
        return

    # Wachstum
    for zeile in range(ZEILEN):
        for spalte in range(SPALTEN):
            daten = beetdaten[zeile][spalte]
            if daten[0] == "wachsend":
                tempo = 1.5 if wetter == "Sonne" else 2.5
                if daten[3]:
                    tempo *= 1.3
                daten[1] += tempo * dt
                if daten[1] >= PFLANZEN[daten[2]]["wachszeit"]:
                    daten[0] = "bereit"
                    beetbild_setzen(spalte, zeile)

    # Wasser-Partikel
    for p in partikel[:]:
        p[0] += p[2]
        p[1] += p[3]
        p[4] -= dt * 1.8
        if p[4] <= 0:
            partikel.remove(p)

    # Wetterwechsel
    wettertimer += dt
    if wettertimer >= WETTERINTERVALL:
        wettertimer = 0.0
        wetter = random.choice(["Sonne", "Sonne", "Regen"])

    # Countdown
    restzeit -= dt
    if restzeit <= 0:
        restzeit = 0
        verloren = True
        if not endesoundgespielt:
            endesoundgespielt = True
            sound("game_over")

    # Level-Up
    if geld >= levelziel:
        naechstes_level()

    # Hase bewegen
    hase_bewtimer -= dt
    if hase_bewtimer <= 0:
        hase_bewtimer = random.uniform(0.6, 1.8)
        hase_dx = random.randint(-2, 2)
        hase_dy = random.randint(-1, 1)
        if hase_dx < 0:
            hase_richtung = "links"
        elif hase_dx > 0:
            hase_richtung = "rechts"
        else:
            hase_richtung = "stehend"

    # Hase bleibt im unteren Spielfeldbereich
    hase.x = max(20,              min(WIDTH - 20,           hase.x + hase_dx))
    hase.y = max(HASE_BEREICH_OBEN, min(HASE_BEREICH_UNTEN, hase.y + hase_dy))

    # Hase-Animation
    if hase_richtung != "stehend":
        hase_animtimer += dt
        if hase_animtimer >= 0.25:
            hase_animtimer = 0.0
            hase_schritt   = 1 - hase_schritt
    bilder     = HASE_BILDER[hase_richtung]
    hase.image = bilder[hase_schritt % len(bilder)]
#draw-funktion
def draw():
    # Hintergrund (740x740) wechselt je nach Wetter
    if wetter == "Sonne":
        screen.blit("hintergrund_sonne", (0, 0))
    else:
        screen.blit("hintergrund_regen", (0, 0))

    # Dekorationsbaeume (32x32)
    baum_links.draw()
    baum_rechts.draw()

    # Beete (48x48) + Pflanzen (18x16) + Fortschrittsbalken
    for zeile in range(ZEILEN):
        for spalte in range(SPALTEN):
            beet_zeichnen(spalte, zeile)

    # Wasser-Partikel (kleine Punkte passend zur Pixel-Art-Groesse)
    for p in partikel:
        screen.draw.filled_circle((int(p[0]), int(p[1])), 2, WASSERFARBE)

    # Hase (16x14)
    hase.draw()

    # UI-Leiste
    ui_zeichnen()

    # Endbildschirm
    if verloren:
        endbildschirm("Game Over!", "Zeit abgelaufen – versuch's nochmal!", ROTFARBE)
    elif gewonnen:
        endbildschirm("Gewonnen!", f"Alle {level} Level gemeistert!", GRUENFARBE)


def beet_zeichnen(spalte, zeile):
    daten = beetdaten[zeile][spalte]
    px    = beet_x(spalte)
    py    = beet_y(zeile)

    # Beet-Bild (48x48)
    beetbilder[zeile][spalte].draw()

    # Pflanzenbild (18x16) zentriert auf dem Beet
    if daten[2] is not None:
        f        = fortschritt(spalte, zeile)
        bildname = PFLANZEN[daten[2]]["reif"] if f >= 0.5 else PFLANZEN[daten[2]]["keim"]
        pflbild        = Actor(bildname)
        # Pflanze mittig auf dem 48x48-Beet, leicht nach oben versetzt
        pflbild.center = (px + BEETGROESSE // 2, py + BEETGROESSE // 2 - 4)
        pflbild.draw()

        # Fortschrittsbalken unter dem Beet (40px breit, 3px hoch)
        if daten[0] == "wachsend":
            bx = px + 4
            by = py + BEETGROESSE + 4
            bw = BEETGROESSE - 8
            screen.draw.filled_rect(Rect(bx, by, bw, 3), (200, 200, 200))
            screen.draw.filled_rect(Rect(bx, by, int(bw * f), 3), GRUENFARBE)

    # Kleines Status-Symbol unter dem Beet
    symboly = py + BEETGROESSE + 10
    if daten[0] == "leer":
        screen.draw.text("+", (px + BEETGROESSE // 2 - 4, symboly),
                         fontsize=14, color=TEXTFARBE)
    elif daten[0] == "wachsend":
        screen.draw.text("~", (px + BEETGROESSE // 2 - 4, symboly),
                         fontsize=14, color=(60, 160, 60))
    elif daten[0] == "bereit":
        screen.draw.text("!", (px + BEETGROESSE // 2 - 3, symboly),
                         fontsize=16, color=ROTFARBE)


def ui_zeichnen():
    kasten(UIFARBE, 0, FARMHOEHE, WIDTH, UI_HOEHE)
    screen.draw.line((0, FARMHOEHE), (WIDTH, FARMHOEHE), GITTERFARBE)

    # Wetter-Text
    wettertext  = "Sonne" if wetter == "Sonne" else "Regen"
    wetterfarbe = GOLDFARBE if wetter == "Sonne" else (100, 140, 220)
    screen.draw.text(f"Wetter: {wettertext}",
                     (10, FARMHOEHE + 8), fontsize=18, color=wetterfarbe)

    # Geld / Level / Zeit
    zeitfarbe = ROTFARBE if restzeit < 15 else TEXTFARBE
    screen.draw.text(f"Geld: {geld}",
                     (200, FARMHOEHE + 8), fontsize=20, color=GOLDFARBE)
    screen.draw.text(f"Level {level}  Ziel: {levelziel}",
                     (370, FARMHOEHE + 8), fontsize=18, color=TEXTFARBE)
    screen.draw.text(f"Zeit: {int(restzeit)}s",
                     (620, FARMHOEHE + 8), fontsize=20, color=zeitfarbe)

    # Shop-Buttons – 4 Buttons gleichmaessig auf 740px verteilt
    shopx = 10
    for name in PFLANZENLISTE:
        p  = PFLANZEN[name]
        hg = p["farbe"] if name == gewaehltepflanze else (240, 230, 235)
        kasten(hg, shopx, FARMHOEHE + 38, 160, 42, radius=6)
        screen.draw.text(name,
                         (shopx + 8, FARMHOEHE + 40), fontsize=14, color=TEXTFARBE)
        screen.draw.text(f"K:{p['kosten']}  +{p['gewinn']}",
                         (shopx + 8, FARMHOEHE + 58), fontsize=12, color=(100, 80, 90))
        if name == gewaehltepflanze:
            screen.draw.rect(Rect(shopx, FARMHOEHE + 38, 160, 42), (180, 100, 140))
        shopx += 183


def endbildschirm(titel, text, farbe):
    kasten((255, 240, 248), WIDTH // 2 - 200, HEIGHT // 2 - 75, 400, 140, radius=18)
    screen.draw.text(titel,
                     center=(WIDTH // 2, HEIGHT // 2 - 28), fontsize=48, color=farbe)
    screen.draw.text(text,
                     center=(WIDTH // 2, HEIGHT // 2 + 22), fontsize=20, color=TEXTFARBE)

musik_an()
pgzrun.go()
