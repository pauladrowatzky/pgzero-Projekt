# Hilfsfunktion für Management Sound/Musik parallel
def sound(name):
    global musik_pause_timer
    try:
        getattr(sounds, name).play()
        music.pause()
        musik_pause_timer = MUSIK_PAUSE_DAUER
    except Exception:
        pass

#Hintergrundmusik als Endlosschleife
def musik_an():
    try:
        music.play("hintergrundmusik")   # pgzero loopt music.play() automatisch
        music.set_volume(0.4)
    except Exception:
        pass
# Funktion für Status der Bilder + Ersetzen mit dem entsprechenden Bild

def beetbild_setzen(spalte, zeile):
    status = beetdaten[zeile][spalte][0]
    if status == "leer":
        beetbilder[zeile][spalte].image = "beet_leer"
    elif status == "wachsend":
        beetbilder[zeile][spalte].image = "beet_wachsend"
    elif status == "bereit":
        beetbilder[zeile][spalte].image = "beet_bereit"

# Fortschritt in Pflanzenwachstum
def fortschritt(spalte, zeile):
    daten = beetdaten[zeile][spalte]
    if daten[2] is None:
        return 0.0
    return min(daten[1] / PFLANZEN[daten[2]]["wachszeit"], 1.0)

def kasten(farbe, x, y, breite, hoehe, radius=8):
    screen.draw.filled_rect(Rect(x + radius, y,          breite - 2*radius, hoehe),           farbe)
    screen.draw.filled_rect(Rect(x,          y + radius, breite,            hoehe - 2*radius), farbe)
    for ex, ey in [(x+radius, y+radius), (x+breite-radius, y+radius),
                   (x+radius, y+hoehe-radius), (x+breite-radius, y+hoehe-radius)]:
        screen.draw.filled_circle((ex, ey), radius, farbe)

# Neustartfunktion nach Beendung Spiel
def neustart():
    # Ausgangszustand aller Variablen, um Neustart umzusetzen
    global zustand, geld, level, levelziel, restzeit
    global verloren, gewonnen, wetter, wettertimer
    global endesoundgespielt, partikel, levelup_timer
    global gewaehltepflanze, musik_pause_timer

    zustand           = "spiel"
    geld              = 50
    level             = 1
    levelziel         = 150
    restzeit          = 90.0
    verloren          = False
    gewonnen          = False
    wetter            = "Sonne"
    wettertimer       = 0.0
    endesoundgespielt = False
    levelup_timer     = 0.0
    musik_pause_timer = 0.0
    partikel          = []
    gewaehltepflanze  = "Salat"

    # Alle Beete zurücksetzen
    for zeile in range(ZEILEN):
        for spalte in range(SPALTEN):
            beetdaten[zeile][spalte] = ["leer", 0.0, None, False]
            beetbild_setzen(spalte, zeile)

    musik_an()

# AB JETZT: EIGENTLICHE SPIELMECHANIK

# funktion für Einpflanzen
def einpflanzen(spalte, zeile):
    global geld
    kosten = PFLANZEN[gewaehltepflanze]["kosten"]
    if geld >= kosten:
        beetdaten[zeile][spalte] = ["wachsend", 0.0, gewaehltepflanze, False]
        geld  = max(0, geld - kosten)   # Geld kann nie unter 0 fallen
        beetbild_setzen(spalte, zeile)
        sound("pflanzen")

# Funktion zum Gießen
def giessen(spalte, zeile):
    daten = beetdaten[zeile][spalte]
    if daten[0] == "wachsend":
        daten[1] += 2.0
        daten[3]  = True
        sound("giessen")
        mx = beet_x(spalte) + BEETGROESSE // 2
        my = beet_y(zeile)  + BEETGROESSE // 2
        for _ in range(8):
            partikel.append([
                mx + random.randint(-10, 10),
                my + random.randint(-10, 10),
                random.uniform(-1.0, 1.0),
                random.uniform(-2.0, -0.3),
                1.0,
            ])

# Funktion für Ernten fertiger Pflanzen
def ernten(spalte, zeile):
    global geld
    daten = beetdaten[zeile][spalte]
    if daten[0] == "bereit":
        geld += PFLANZEN[daten[2]]["gewinn"]
        beetdaten[zeile][spalte] = ["leer", 0.0, None, False]
        beetbild_setzen(spalte, zeile)
        sound("ernten")

# Funktion für Levelaufstieg nach Sieg
def naechstes_level():
    global level, levelziel, restzeit, gewonnen, levelup_timer
    if level >= 3:
        gewonnen = True
        return
    level         += 1
    levelziel      = int(levelziel * 2.2)
    restzeit       = max(restzeit, 60.0) + 30.0
    levelup_timer  = 2.5   # Anzeige fuer 2,5 Sekunden einblenden
    sound("level_up")

# Funktion für Ineraktion bei Klicken auf Objekte
def on_mouse_down(pos):
    global zustand, gewaehltepflanze
    # bei Klick starten
    if zustand == "start":
        neustart()
        return
    # bei Klick Neustart
    if zustand == "ende":
        neustart()
        return
    # laufendes Spiel
    if zustand == "spiel":

        # Shop-Buttons
        shopx = 10
        for name in PFLANZENLISTE:
            if shopx <= pos[0] <= shopx + 160 and FARMHOEHE + 38 <= pos[1] <= FARMHOEHE + 80:
                gewaehltepflanze = name
                return
            shopx += 183

        # Beete
        for zeile in range(ZEILEN):
            for spalte in range(SPALTEN):
                if beetbilder[zeile][spalte].collidepoint(pos):
                    status = beetdaten[zeile][spalte][0]
                    if status == "leer":
                        einpflanzen(spalte, zeile)
                    elif status == "wachsend":
                        giessen(spalte, zeile)
                    elif status == "bereit":
                        ernten(spalte, zeile)
                    return


