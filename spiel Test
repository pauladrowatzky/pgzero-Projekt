# Update-Funktion
def update(dt):
    global restzeit, verloren, gewonnen, zustand
    global wetter, wettertimer
    global hase_richtung, hase_schritt, hase_bewtimer, hase_animtimer
    global hase_dx, hase_dy
    global endesoundgespielt, levelup_timer, musik_pause_timer

    # Auf Start-/Endbildschirm nichts berechnen
    if zustand != "spiel":
        return

    # Musikpause-Timer -> für Umgang Timing Sounds + Musik
    if musik_pause_timer > 0:
        musik_pause_timer -= dt
        if musik_pause_timer <= 0:
            musik_pause_timer = 0.0
            try:
                music.unpause()   
            except Exception:
                
    # Levelaufstieg sichtbar in Anzeige
    if levelup_timer > 0:
        levelup_timer -= dt

    # Funktion für Wachstum
    for zeile in range(ZEILEN):
        for spalte in range(SPALTEN):
            daten = beetdaten[zeile][spalte]
            if daten[0] == "wachsend":
                tempo = 1.5 if wetter == "Sonne" else 2.5
                if daten[3]:
                    tempo *= 1.3
                daten[1] += tempo * dt
                if daten[1] >= PFLANZEN[daten[2]]["wachszeit"]:
                    daten[0] = "bereit"
                    beetbild_setzen(spalte, zeile)

    # Wasserpartikel
    for p in partikel[:]:
        p[0] += p[2]
        p[1] += p[3]
        p[4] -= dt * 1.8
        if p[4] <= 0:
            partikel.remove(p)

    # Wetterwechsel
    wettertimer += dt
    if wettertimer >= WETTERINTERVALL:
        wettertimer = 0.0
        wetter = random.choice(["Sonne", "Sonne", "Regen"])

    # Countdown (restliche Zeit im Level)
    restzeit -= dt
    if restzeit <= 0:
        restzeit = 0
        verloren = True
        zustand  = "ende"
        if not endesoundgespielt:
            endesoundgespielt = True
            sound("game_over")

    # Levelaufstieg
    if geld >= levelziel and not gewonnen:
        naechstes_level()
        if gewonnen:
            zustand = "ende"

    # Bewegung Hase mit Fotos sichtbar
    hase_bewtimer -= dt
    if hase_bewtimer <= 0:
        hase_bewtimer = random.uniform(0.6, 1.8)
        hase_dx = random.randint(-2, 2)
        hase_dy = random.randint(-1, 1)
        if hase_dx < 0:
            hase_richtung = "links"
        elif hase_dx > 0:
            hase_richtung = "rechts"
        else:
            hase_richtung = "stehend"

    hase.x = max(20,               min(WIDTH - 20,            hase.x + hase_dx))
    hase.y = max(HASE_BEREICH_OBEN, min(HASE_BEREICH_UNTEN,  hase.y + hase_dy))

    if hase_richtung != "stehend":
        hase_animtimer += dt
        if hase_animtimer >= 0.25:
            hase_animtimer = 0.0
            hase_schritt   = 1 - hase_schritt
    bilder     = HASE_BILDER[hase_richtung]
    hase.image = bilder[hase_schritt % len(bilder)]

# Zeichnungsfunktion
def draw():
    if zustand == "start":
        startbildschirm_zeichnen()
        return

    # Hintergrund wechselt je nach Wetter
    if wetter == "Sonne":
        screen.blit("hintergrund_sonne", (0, 0))
    else:
        screen.blit("hintergrund_regen", (0, 0))

    baum_links.draw()
    baum_rechts.draw()

    for zeile in range(ZEILEN):
        for spalte in range(SPALTEN):
            beet_zeichnen(spalte, zeile)

    for p in partikel:
        screen.draw.filled_circle((int(p[0]), int(p[1])), 2, WASSERFARBE)

    hase.draw()
    ui_zeichnen()

    # Level-Up-Anzeige
    if levelup_timer > 0:
        levelup_anzeige_zeichnen()

    # Endbildschirm
    if zustand == "ende":
        if verloren:
            endbildschirm_zeichnen("Game Over!",
                                   "Zeit abgelaufen.",
                                   "Klick zum Neustart",
                                   ROTFARBE)
        elif gewonnen:
            endbildschirm_zeichnen("Gewonnen!",
                                   f"Alle {level} Level gemeistert!",
                                   "Klick zum Neustart",
                                   GRUENFARBE)

# Start
musik_an()
pgzrun.go()
